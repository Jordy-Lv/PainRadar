# ============ TRACK VENTAS (marketplaces) ============
# Token OAuth2 de https://accounts.freelancer.com/settings/develop
FREELANCER_OAUTH_TOKEN=
FREELANCER_ENV=prod          # prod | sandbox

# Fase 3
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# ============ TRACK CONTRIBUCIONES (foros públicos) ============
# Personal access token (solo scope public_repo o ninguno; 5000 req/h autenticado)
GITHUB_TOKEN=
# Opcional: https://stackapps.com/apps/oauth/register -> sube la cuota a 10k/día
STACKEXCHANGE_KEY=
# App tipo "script" en https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=painradar/0.1 by u/tu_usuario

# ============ IA ============
ANTHROPIC_API_KEY=

# ============ DOS BOTS DE TELEGRAM ============
TELEGRAM_SALES_BOT_TOKEN=
TELEGRAM_SALES_CHAT_ID=
TELEGRAM_CONTRIB_BOT_TOKEN=
TELEGRAM_CONTRIB_CHAT_ID=

# ============ GENERAL ============
DATABASE_URL=sqlite:///data/painradar.db
MODE=discovery               # discovery | live
LOG_LEVEL=INFO
